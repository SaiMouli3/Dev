\@writefile{lot}{\contentsline {table}{\numberline {S3}{\ignorespaces Information-greedy (Bayesian experimental design) results, removed from the main tables. Paired relative difference in mean reads against round-robin with verified stopping on jointly successful retrievals (cluster-bootstrap 95\% CI). $^{s}$: mean over successful retrievals. Thousands of reads.}}{3}{}\protected@file@percent }
\newlabel{tab:suppinfo}{{S3}{3}{}{}{}}
\@writefile{lot}{\contentsline {table}{\numberline {S4}{\ignorespaces One failed container: cost conditional on success and over all attempts (300 retrievals per row, 72k-read stream). Every policy has the same success probability, so the conditional saving does not buy a better chance of recovery, and failures dominate the unconditional mean. Thousands of reads.}}{3}{}\protected@file@percent }
\newlabel{tab:uncond}{{S4}{3}{}{}{}}
