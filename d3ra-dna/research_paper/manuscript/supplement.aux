\@writefile{lof}{\contentsline {figure}{\numberline {S2}{\ignorespaces Reliability of the completion forecast on the digital twin: forecast probability of finishing within the remaining budget against the observed frequency of finishing, pooled over checkpoints at 30/50/70/85\% of the budget (10 equal-width bins, bins with fewer than five checkpoints dropped). A calibrated forecast would lie on the diagonal; both curves lie below it, so both are over-confident, and both have a worse Brier score than a constant forecast at the base rate.}}{5}{}\protected@file@percent }
\newlabel{fig:forecast}{{S2}{5}{}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {S3}{\ignorespaces Severity sweep: mean reads consumed as the degraded container's copy number falls from 200 to 1 (300 retrievals per point and policy, 95\% cluster-bootstrap intervals; the axis runs from mild to severe degradation). Every retrieval at every level returned the correct file, so the success probability is 1.00 throughout and is not plotted. Adaptive rules are cheaper than round-robin only at the mild end.}}{5}{}\protected@file@percent }
\newlabel{fig:sweep}{{S3}{5}{}{}{}}
