\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Architecture of the study. \textbf  {(1)}\nonbreakingspace A file is bundled with its SHA-256, split into $S{=}25$ stripes of $K{=}32$ data fragments and extended by a Cauchy Reed--Solomon code to $N{=}48$; each fragment becomes one 136-nt strand (address, payload, inner RS parity, CRC-16) and the strands are placed round-robin over $M{=}6$ containers with different handling histories. \textbf  {(2)}\nonbreakingspace Each container is an independent DT4DDS synthesis, aging, PCR and sequencing run that yields its own read stream. \textbf  {(3)}\nonbreakingspace Retrieval reads the streams in batches of 50 reads and makes two decisions after every batch: \emph  {which} container to read next (allocation) and \emph  {whether to stop} (verified stopping, which requires every stripe to decode and the CRC-32 and SHA-256 checks to pass). The stored file is used only after a retrieval ends, to count wrong outputs and false accepts.}}{5}{figure.caption.2}\protected@file@percent }
\providecommand*\caption@xref[2]{\@setref\relax\@undefined{#1}}
\newlabel{fig:arch}{{1}{5}{Architecture of the study. \textbf {(1)}~A file is bundled with its SHA-256, split into $S{=}25$ stripes of $K{=}32$ data fragments and extended by a Cauchy Reed--Solomon code to $N{=}48$; each fragment becomes one 136-nt strand (address, payload, inner RS parity, CRC-16) and the strands are placed round-robin over $M{=}6$ containers with different handling histories. \textbf {(2)}~Each container is an independent DT4DDS synthesis, aging, PCR and sequencing run that yields its own read stream. \textbf {(3)}~Retrieval reads the streams in batches of 50 reads and makes two decisions after every batch: \emph {which} container to read next (allocation) and \emph {whether to stop} (verified stopping, which requires every stripe to decode and the CRC-32 and SHA-256 checks to pass). The stored file is used only after a retrieval ends, to count wrong outputs and false accepts}{figure.caption.2}{}}
